/*******************************************************************************************
  Include Libraries
  (Uncomment and include additional libraries as needed)
*******************************************************************************************/
// #CRESTRON_LIBRARY ""
// #USER_LIBRARY ""
#CRESTRON_SIMPLSHARP_LIBRARY "SSH_Interface_v1.7"

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT Connect;
DIGITAL_INPUT Accept_New_Key;
DIGITAL_INPUT Decline_New_Key;
DIGITAL_INPUT Retry;
STRING_INPUT IP_Address_Override[64];
BUFFER_INPUT To_Device[1000];

DIGITAL_OUTPUT Is_Connected;
DIGITAL_OUTPUT Reconnect;
DIGITAL_OUTPUT Accept_New_Key_Notice;
ANALOG_OUTPUT Connection_Status_Out;
STRING_OUTPUT New_Key_Text;
STRING_OUTPUT Connection_Status_Text;
STRING_OUTPUT From_Device;

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/

STRING_PARAMETER _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, IP_Address[15];
INTEGER_PARAMETER IP_Port;
STRING_PARAMETER Username[20];
STRING_PARAMETER Password[20];
INTEGER_PARAMETER Accept_Any_Key;
INTEGER_PARAMETER Unique_ID;
INTEGER_PARAMETER Debug;

SSH_Interface UserClass;

/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/

INTEGER	iConnectRequest;
INTEGER Connection_Status;
STRING IPAddress[64];
  
/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/

Callback GatherEventHandler HandleTxChange(GatherEventArgs args)
{
	String Temp$[1000];
	Signed_Integer TxStatus;
	Signed_Integer RearmSuccess;
	Signed_Integer RecreateSuccess;
	Integer RearmTries;
	
	if(args.Results = 0)
	{
		Temp$ = args.RxString;
		If(Len(To_Device) > 0)
		{
			Temp$ = Temp$ + RemoveByLength(Len(To_Device),To_Device);
		}
		UserClass.Command_In(Temp$);
	}
	
	RearmTries = 0;
	Do
	{
		RearmSuccess = RearmGatherAsync(args.Input);
		RearmTries = RearmTries + 1;
	}
	Until((RearmSuccess >= 0) || (RearmTries >= 10));

	if(RearmTries >= 10)
	{
		GenerateUserError("(%s) Failed to RearmGatherAsync, Attempting to create new GatherAsync", GetSymbolInstanceName());
		RecreateSuccess = GatherAsyncByLength(1,To_Device,HandleTxChange);
		GenerateUserError("(%s) Creating new GatherAsync, result = %d", GetSymbolInstanceName(), RecreateSuccess);
	}
}


Function RegDelegates()
{
	RegisterDelegate(UserClass, SendFromDevice, ProcessFromDevice);
	RegisterDelegate(UserClass, SendConnectionStatus, ProcessConnectionStatus);
	RegisterDelegate(UserClass, SendFingerprint, ProcessFingerprint);
}
          
Callback Function ProcessFromDevice(STRING ReturnFromDevice)
{
	From_Device = ReturnFromDevice;
}

Callback Function ProcessFingerprint(STRING Fingerprint)
{
	New_Key_Text = Fingerprint;
}

Function RetryConnection()
{
	UserClass.Connect(IPAddress, IP_Port, Username, Password);
}

Callback Function ProcessConnectionStatus(STRING ConnectedValue)
{
	processlogic();
	if(ConnectedValue = "True")
	{
		Reconnect = 0;
		if(Connection_Status <> 2)
		{	
			Connection_Status = 2;
			Connection_Status_Out = Connection_Status;
			Connection_Status_Text = "Connected";
		}
		Is_Connected = 1;	
		
    }
	else if(ConnectedValue = "False")
	{
		if(Connection_Status <> 3)
		{
			Connection_Status = 3;
			Connection_Status_Out = Connection_Status;
			Connection_Status_Text = "Not Connected";    
		}
		Is_Connected = 0;
		processlogic();

		if(iConnectRequest = 1)
		{
			Connection_Status = 1;
			Connection_Status_Out = Connection_Status;
			Connection_Status_Text = "Trying To Connect";
			wait(5)
			{
     			RetryConnection();
			}       
		}
	}
	else if(ConnectedValue = "Non-Matching Fingerprint")
	{
		Accept_New_Key_Notice = 1;
		iConnectRequest = 0;
		Reconnect = 0;
	}
}


/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/


RELEASE Connect
{
	iConnectRequest = 0;  
    UserClass.Disconnect();  
	Accept_New_Key_Notice = 0;
}

PUSH Connect
{
	Connection_Status = 1;
	Connection_Status_Out = Connection_Status;
	Connection_Status_Text = "Trying To Connect";
	iConnectRequest = 1;
   	UserClass.Connect(IPAddress, IP_Port, Username, Password);
}

PUSH Accept_New_Key
{
	Connection_Status = 1;
	Connection_Status_Out = Connection_Status;
	Connection_Status_Text = "Trying To Connect";    	
	iConnectRequest = 1;
	UserClass.Accept_New_Key();
	Accept_New_Key_Notice = 0;
   	UserClass.Connect(IPAddress, IP_Port, Username, Password);
}

PUSH Decline_New_Key
{   
	UserClass.Decline_New_Key();
	Accept_New_Key_Notice = 0;
}

PUSH Retry
{
	Connection_Status = 1;
	Connection_Status_Out = Connection_Status;
	Connection_Status_Text = "Trying To Connect";    
    UserClass.Connect(IPAddress, IP_Port, Username, Password);
}

CHANGE IP_Address_Override
{
	IPAddress = IP_Address_Override;
}


/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	WaitForInitializationComplete();
	IPAddress = IP_Address;
	
	RegDelegates();
	UserClass.Debug(Debug);
	UserClass.Accept_Any_Key(Accept_Any_Key);

	UserClass.Unique_ID(Unique_ID);
    if(Connection_Status <> 1 && Connection_Status <> 2)
	{ 
		Connection_Status = 3;
		Connection_Status_Out = Connection_Status;
		Connection_Status_Text = "Not Connected";    
		Is_Connected = 0;
	}
	UserClass.LoadSettings();
	Accept_New_Key_Notice = 0;

	GatherAsyncByLength(1,To_Device,HandleTxChange);
}





